{
  "rewrites": [
    {
      "source": "/invite/:inviteCode",
      "destination": "/api/invite-page?inviteCode=:inviteCode"
    },
    {
      "source": "/:subject(physics|chemistry|maths|math|biology)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ChatGPT-User|PerplexityBot|ClaudeBot|anthropic-ai|Google-Extended|Bingbot|cohere-ai|OAI-SearchBot|Bytespider|Diffbot|FacebookBot|Meta-ExternalAgent|Applebot-Extended|Googlebot).*"
        }
      ],
      "destination": "/api/subject-prerender?subject=:subject"
    },
    {
      "source": "/:subject(physics|chemistry|maths|math|biology)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*(text/markdown|text/x-markdown).*"
        }
      ],
      "destination": "/api/subject-prerender?subject=:subject"
    },
    {
      "source": "/:subject(physics|chemistry|maths|math|biology)",
      "has": [
        {
          "type": "query",
          "key": "format",
          "value": "markdown"
        }
      ],
      "destination": "/api/subject-prerender?subject=:subject"
    },
    {
      "source": "/:subject(physics|chemistry|maths|math|biology)",
      "has": [
        {
          "type": "query",
          "key": "format",
          "value": "html"
        }
      ],
      "destination": "/api/subject-prerender?subject=:subject"
    },
    {
      "source": "/((?!api/|assets/|data/|@|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/subject-prerender",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, User-Agent"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-:hash.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
